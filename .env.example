APP_ENV=development
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_TIMEOUT=2s
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_ABSOLUTE_TTL=720h
AUTH_REFRESH_IDLE_TTL=168h
AUTH_EMAIL_VERIFICATION_TTL=24h
AUTH_ARGON2_TIME=3
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_THREADS=2
AUTH_ARGON2_KEY_LEN=32
MEDIA_ALLOWED_CONTENT_TYPES=
MEDIA_MAX_BYTE_SIZE=0
MEDIA_UPLOAD_URL_TTL=15m
STORAGE_PROVIDER=unconfigured
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BASE_PATH=
IMAGE_PROCESSOR_PROVIDER=unconfigured
TINIFY_API_KEY=
TINIFY_BASE_URL=https://api.tinify.com
TINIFY_HTTP_TIMEOUT=30s
MEDIA_PROFILE_DETAIL_WIDTH=
MEDIA_PROFILE_DETAIL_HEIGHT=
MEDIA_PROFILE_HOMEPAGE_WIDTH=
MEDIA_PROFILE_HOMEPAGE_HEIGHT=
MEDIA_PROFILE_SEARCH_WIDTH=
MEDIA_PROFILE_SEARCH_HEIGHT=
