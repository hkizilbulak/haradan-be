APP_ENV=development
HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=
# Development (APP_ENV=development): http(s)://localhost|127.0.0.1|[::1][:port]
# is allowed automatically so Expo/Vite can use any local port.
# Production/staging: list exact browser origins only (no wildcard).
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_TIMEOUT=2s
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_ABSOLUTE_TTL=720h
AUTH_REFRESH_IDLE_TTL=168h
AUTH_EMAIL_VERIFICATION_TTL=24h
AUTH_ARGON2_TIME=3
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_THREADS=2
AUTH_ARGON2_KEY_LEN=32
MEDIA_ALLOWED_CONTENT_TYPES=
MEDIA_MAX_BYTE_SIZE=0
MEDIA_UPLOAD_URL_TTL=15m
STORAGE_PROVIDER=unconfigured
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BASE_PATH=
IMAGE_PROCESSOR_PROVIDER=unconfigured
TINIFY_API_KEY=
TINIFY_BASE_URL=https://api.tinify.com
TINIFY_HTTP_TIMEOUT=30s
MEDIA_PROFILE_DETAIL_WIDTH=
MEDIA_PROFILE_DETAIL_HEIGHT=
MEDIA_PROFILE_HOMEPAGE_WIDTH=
MEDIA_PROFILE_HOMEPAGE_HEIGHT=
MEDIA_PROFILE_SEARCH_WIDTH=
MEDIA_PROFILE_SEARCH_HEIGHT=
EMAIL_PROVIDER=unconfigured
RESEND_API_KEY=
FROM_EMAIL=
FROM_NAME=
FRONTEND_URL=
RESEND_REGISTRATION_VERIFICATION_TEMPLATE_ID=
RESEND_WELCOME_TEMPLATE_ID=
RESEND_RESET_PASSWORD_TEMPLATE_ID=
RESEND_BASE_URL=https://api.resend.com
EMAIL_HTTP_TIMEOUT=30s
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL=1s
WORKER_LEASE_DURATION=2h5m
WORKER_JOB_TIMEOUT=60s
WORKER_MAX_JOB_TIMEOUT=2h
WORKER_ID=
WORKER_SHUTDOWN_TIMEOUT=30s
WORKER_RETRY_BASE_DELAY=5s
WORKER_RETRY_MAX_DELAY=5m
WORKER_LEASE_RECOVERY_INTERVAL=30s
NOTIFICATION_FANOUT_BATCH_SIZE=100
NOTIFICATION_EMAIL_CHUNK_SIZE=25
PACKAGE_EXPIRY_TIMEZONE=Europe/Istanbul
PACKAGE_EXPIRY_SCAN_HOUR=9
PACKAGE_EXPIRY_SCHEDULER_INTERVAL=1h
JOB_SCHEDULER_REFRESH_INTERVAL=1m
PACKAGE_EXPIRY_SCAN_BATCH_SIZE=100
MEDIA_PUBLIC_BASE_URL=
# Explicit opt-in. TJK_BASE_URL by itself does not enable TJK.
TJK_ENABLED=false
TJK_BASE_URL=
TJK_HTTP_TIMEOUT=60s
TJK_PAGE_TIMEOUT=15m
TJK_MAX_BODY_BYTES=2097152
# Live Turkey province/district catalog (api.turkiyeapi.dev). Default on.
# Selected district is stored on the advert; this is not a hand-maintained seed.
GEO_CATALOG_ENABLED=true
GEO_CATALOG_URL=https://api.turkiyeapi.dev
GEO_CATALOG_HTTP_TIMEOUT=15s
GEO_CATALOG_TTL=24h
GEO_CATALOG_MAX_BODY_BYTES=2097152
# Browser uploads go through BE PUT /v1/media/assets/{id}/content (avoids B2 CORS).
# Optional: go run ./cmd/b2cors to allow direct browser PUT to the bucket.
